APP_ENV=development
APP_NAME=Subscription Optimization API
APP_VERSION=0.1.0
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
POSTGRES_DB=sub_tracker
POSTGRES_USER=sub_tracker
POSTGRES_PASSWORD=sub_tracker_local
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://sub_tracker:sub_tracker_local@postgres:5432/sub_tracker
REDIS_URL=redis://redis:6379/0

# Auth (issue #5) — provisional pending issue #1's ADR. Generate a real
# secret for any non-local environment, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-change-me-please-at-least-32-bytes-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
AUTH_RATE_LIMIT=5/minute
